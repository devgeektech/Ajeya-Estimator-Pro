# Django
# Generate a real value on the server:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=generate-a-real-secret-key
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=13.205.90.58,localhost,127.0.0.1

# PostgreSQL
# Keep the real password only in the uncommitted .env file on the server.
DATABASE_URL=postgres://boq_user:change-me@localhost:5432/boq_db

# Redis / Celery (required in production when DEBUG=False)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production: leave empty or False — analysis runs via Celery worker.
# Local dev without Redis/worker: set True, or use DEBUG=True (defaults to eager).
CELERY_TASK_ALWAYS_EAGER=

# OpenAI
# Leave blank until a production API key is available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Save full AI prompts/responses to logs/instructions.log (set False to disable)
AI_INSTRUCTION_LOGGING=True
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=500
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
AI_ROW_EXTRACTION_BATCH_SIZE=10

# Local vector index
CHROMA_PATH=media/chroma
CHROMA_COLLECTION=rate_master_products

# Email
# Leave EMAIL_HOST blank until SMTP is configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@boq-ai.local

# HTTPS hardening
# Keep false while using the EC2 public IP over HTTP. Enable after domain + TLS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Gunicorn
GUNICORN_BIND=unix:/run/boq_ai/gunicorn.sock
GUNICORN_WORKERS=3

# AWS storage is not active yet.
AWS_STORAGE_BUCKET=
