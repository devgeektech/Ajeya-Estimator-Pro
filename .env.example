# Django
# Generate a real value on the server:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=generate-a-real-secret-key
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=13.205.90.58,localhost,127.0.0.1
# Required for POSTs in Django 4+. Scheme must match how users open the site.
CSRF_TRUSTED_ORIGINS=http://13.205.90.58,http://localhost,http://127.0.0.1

# PostgreSQL
# Keep the real password only in the uncommitted .env file on the server.
DATABASE_URL=postgres://boq_user:change-me@localhost:5432/boq_db
CONN_MAX_AGE=60

# Redis / Celery (required in production when DEBUG=False)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production: False — analysis runs via Celery worker.
# Local dev without Redis/worker: set True, or use DEBUG=True (defaults to eager).
CELERY_TASK_ALWAYS_EAGER=False
# Max age (seconds) of media/job_progress/celery_worker_heartbeat.json
CELERY_WORKER_HEARTBEAT_MAX_AGE=45

# OpenAI
# Required on EC2 for Analyse. Local DEBUG/eager still needs it to call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ROW_EXTRACTION_BATCH_SIZE=5
AI_PRODUCT_MAPPING_BATCH_SIZE=4
# Full prompt/response dumps to logs/instructions.log — keep False in production.
AI_INSTRUCTION_LOGGING=False
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=500
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1

# Local vector index
CHROMA_PATH=media/chroma
CHROMA_COLLECTION=rate_master_products

# Email
# Leave EMAIL_HOST blank until SMTP is configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@boq-ai.local

# HTTPS hardening
# Keep false while using the EC2 public IP over HTTP. Enable after domain + TLS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Gunicorn (read by backend/config/gunicorn.conf.py)
GUNICORN_BIND=unix:/run/boq_ai/gunicorn.sock
GUNICORN_WORKERS=3
# Database import runs in the web process — keep this >= nginx proxy_read_timeout.
GUNICORN_TIMEOUT=600

# AWS storage is not active yet.
AWS_STORAGE_BUCKET=
